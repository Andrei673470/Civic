# Copie este arquivo, renomeie para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" pro GitHub ou compartilhe publicamente.

# Encontrado em developers.facebook.com > seu app > Configurações Básicas
FACEBOOK_APP_ID=coloque_aqui_o_app_id
FACEBOOK_APP_SECRET=coloque_aqui_o_app_secret

# Uma senha que VOCÊ inventa (qualquer texto). Use a mesma no campo
# "Verify Token" na Meta ao configurar o Webhook do WhatsApp.
WHATSAPP_VERIFY_TOKEN=escolha-uma-senha-aqui-123
